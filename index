<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Awesome Website</title>
    <!-- Link to our external CSS stylesheet -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header containing our navigation menu, search bar, and dark mode toggle -->
    <header>
        <nav class="navbar">
            <div class="logo">MySite</div>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
            <div class="nav-actions">
                <input type="text" id="searchInput" placeholder="Search...">
                <button id="darkModeToggle">🌙 Dark Mode</button>
            </div>
        </nav>
    </header>

    <!-- Main interactive content section -->
    <main id="home">
        <section class="card">
            <h2>Interactive Zone</h2>
            <p>Click the button below to change the accent color!</p>
            <button id="colorBtn">Change Color</button>
        </section>
    </main>

    <!-- Footer section -->
    <footer>
        <p>&copy; 2026 My Web Development Journey</p>
    </footer>

    <!-- Link to our external JavaScript file -->
    <script src="script.js"></script>
</body>
</html>
